# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string for local/production persistence.
# Example: postgresql://user:password@localhost:5432/credit_risk
# When unset (e.g., live online preview), the server uses the embedded presentation store.
DATABASE_URL=""

# ALLOW_MEMORY_FALLBACK: Set to "false" in strict production to fail closed (503) if Postgres is unreachable.
ALLOW_MEMORY_FALLBACK="true"

# SCORING_API_URL: Optional Python FastAPI + LightGBM inference service URL (e.g. http://localhost:8000).
# When unset, Node executes the exported LightGBM-compatible JSON tree ensemble (server/artifacts/gbdt_model.json).
SCORING_API_URL=""

# ALLOW_PYTHON_FALLBACK: Set to "false" in strict production to fail closed (503) if SCORING_API_URL is unreachable.
ALLOW_PYTHON_FALLBACK="true"
